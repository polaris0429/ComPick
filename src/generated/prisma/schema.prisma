// ComPick Prisma 스키마
//
// 클라이언트는 이 파일이 있는 위치가 아니라, 아래 output 경로(src/generated/prisma)에
// 생성됩니다. Next.js standalone 빌드가 node_modules 깊숙한 경로를 트레이싱하지 못해
// Prisma 엔진 바이너리가 누락되는 문제를 피하기 위한 선택입니다 (next.config.ts 참고).
//
// 코드에서는 `@prisma/client`가 아니라 `@/generated/prisma`에서 import 합니다.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════
// User — 로그인 / 회원가입 / 정보수정 / 비밀번호 수정 (Step 6에서 Auth.js와 연동)
// ════════════════════════════════════════════════════════════════

enum UserRole {
  USER
  ADMIN
}

model User {
  isActive Boolean @default(true)
  id       String  @id @default(cuid())

  /// AES-256-GCM으로 암호화된 값 (src/lib/encryption.ts, 평문으로 저장하지 않음)
  email String

  /// HMAC-SHA256 조회용 해시. 로그인 시 이 컬럼으로 조회합니다
  /// (email 컬럼은 암호화 시 매번 값이 달라져 등호 조회가 불가능합니다).
  emailHash String @unique

  /// bcrypt 해시. 평문 비밀번호는 어디에도 저장하지 않습니다.
  passwordHash String

  /// AES-256-GCM; legacy rows marked with nameEncrypted=false until migrated.
  name                   String
  nameEncrypted          Boolean         @default(false)
  /// Optional saved delivery details, encrypted with AES-256-GCM.
  phoneEncrypted         String?
  addressEncrypted       String?
  addressDetailEncrypted String?
  loginId                String?
  loginIdHash            String?         @unique
  sessions               MemberSession[]
  cartItems              CartItem[]
  role                   UserRole        @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("users")
}

// ════════════════════════════════════════════════════════════════
// Category — 좌측 패널 부품 카테고리 (Step 4의 좌측 네비게이션이 참조)
// ════════════════════════════════════════════════════════════════

enum CategoryCode {
  CPU
  MOTHERBOARD
  RAM
  GPU
  STORAGE
  PSU
  CASE
  COOLER
}

model Category {
  id   String       @id @default(cuid())
  code CategoryCode @unique
  name String // 화면 표시용 한글 이름 (예: "메인보드")

  sortOrder Int @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// ════════════════════════════════════════════════════════════════
// Product — 개별 부품 (중앙 패널 상품 리스트, 우측 패널 견적에 사용)
// ════════════════════════════════════════════════════════════════

model Product {
  id    String @id @default(cuid())
  name  String
  brand String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// 원(KRW) 단위 정수 가격 (소수점 없음)
  price Int

  /// 0~100 사이 할인율(%). 할인 적용가 = price * (100 - discountRate) / 100
  discountRate Int @default(0)

  /// 상품 사진 여러 장 (첫 번째 값이 목록/상세 대표 이미지로 쓰임).
  images String[] @default([])

  description String?

  /// 상세 모달 "상품정보" 탭의 마케팅 카피(eyebrow/제목/본문/특징 3개/프로모).
  /// "상세 스펙" 탭은 attributes를 그대로 표로 보여주므로 별도 필드가 필요
  /// 없습니다. 형태 정의는 src/types/product-detail.ts의 MarketingContent 참고.
  marketingContent Json? @db.JsonB

  /// 카테고리별로 형태가 다른 스펙(소켓, 용량, 와트수 등).
  /// 형태 정의는 src/types/product-attributes.ts 참고.
  attributes Json @db.JsonB

  salesCount Int     @default(0)
  stock      Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems          CartItem[]
  orderItems         OrderItem[]
  prebuiltComponents PrebuiltPCComponent[]

  @@index([categoryId])
  @@index([salesCount])
  @@map("products")
}

// ════════════════════════════════════════════════════════════════
// PrebuiltPC — 완제품 PC (중앙 패널의 "완제품" 전용 탭)
// ════════════════════════════════════════════════════════════════

model PrebuiltPC {
  kind        String   @default("STANDARD")
  stock       Int      @default(0)
  specText    String   @default("")
  infoImages  String[] @default([])
  id          String   @id @default(cuid())
  name        String
  description String?
  images      String[] @default([])

  price        Int
  discountRate Int @default(0)
  salesCount   Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components PrebuiltPCComponent[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("prebuilt_pcs")
}

/// 완제품 PC를 구성하는 개별 부품들 (다대다 관계의 조인 테이블)
model PrebuiltPCComponent {
  id String @id @default(cuid())

  prebuiltPCId String
  prebuiltPC   PrebuiltPC @relation(fields: [prebuiltPCId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  @@unique([prebuiltPCId, productId])
  @@map("prebuilt_pc_components")
}

// ════════════════════════════════════════════════════════════════
// Order — 주문 (Step 5의 토스페이먼츠 결제 승인이 채워 넣음)
// ════════════════════════════════════════════════════════════════

enum OrderStatus {
  PENDING // 결제창 진입 전 임시 생성
  PAID // 서버 승인(confirm) 완료
  FAILED // 결제 실패/취소
  CANCELLED // 사용자/관리자 취소
}

model Order {
  shippingStatus    String    @default("PREPARING")
  courier           String    @default("")
  trackingNumber    String    @default("")
  shippedAt         DateTime?
  deliveredAt       DateTime?
  requestKey        String?   @unique
  shippingEncrypted String?
  inventory         Json?
  stockReserved     Boolean   @default(false)
  id                String    @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status OrderStatus @default(PENDING)

  /// 할인 적용 전 합계
  totalAmount    Int
  /// 총 할인액
  discountAmount Int @default(0)
  /// 실제 결제(승인) 금액. Step 5에서 토스페이먼츠 confirm API 응답의 금액과
  /// 이 값을 대조해 위변조 여부를 검증합니다.
  finalAmount    Int

  /// 토스페이먼츠에 전달하는 주문 식별자
  tossOrderId    String? @unique
  /// 결제 승인 후 토스페이먼츠가 발급하는 결제 키
  tossPaymentKey String? @unique

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

/// 주문 항목. productId(개별 부품) 또는 prebuiltPCId(완제품) 중 정확히 하나만
/// 채워집니다 — Prisma 스키마 레벨에서는 이 상호배타 제약을 표현할 수 없으므로
/// Step 5의 주문 생성 로직에서 애플리케이션 레벨로 검증합니다.
model OrderItem {
  image String @default("")
  name  String @default("")
  id    String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  prebuiltPCId String?
  prebuiltPC   PrebuiltPC? @relation(fields: [prebuiltPCId], references: [id])

  quantity Int @default(1)

  /// 주문 시점 단가 스냅샷. 이후 상품 가격이 바뀌어도 과거 주문 금액은 불변으로 유지됩니다.
  unitPrice Int

  @@index([orderId])
  @@index([productId])
  @@index([prebuiltPCId])
  @@map("order_items")
}

model MemberSession {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("member_sessions")
}

model CartItem {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  prebuiltPCId String?
  prebuiltPC   PrebuiltPC? @relation(fields: [prebuiltPCId], references: [id], onDelete: Cascade)
  quantity     Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, productId])
  @@unique([userId, prebuiltPCId])
  @@map("cart_items")
}

model MemberRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("member_rate_limits")
}
