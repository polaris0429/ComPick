{
  "name": "compick",
  "version": "0.1.0",
  "private": true,
  "description": "ComPick(컴픽) - 부품 호환성을 자동으로 검증하는 맞춤형 조립 PC 쇼핑몰",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "docker:up": "docker compose up -d db",
    "docker:up:all": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@tosspayments/tosspayments-sdk": "2.8.1",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.38.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
