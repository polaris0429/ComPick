# ─────────────────────────────────────────────────────────────
# ComPick 환경변수 예시 파일
# 사용법: cp .env.example .env  후 필요한 값을 채워 넣으세요.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER="compick"
POSTGRES_PASSWORD="compick_dev_password"
POSTGRES_DB="compick"

# Prisma 가 사용하는 DB 연결 URL
DATABASE_URL="postgresql://compick:compick_dev_password@localhost:5432/compick?schema=public"

# ── 보안 / 암호화 ──────────────────────────────────────────
# AES-256-GCM 필드 암호화 키 (32바이트 hex = 64자)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=""

# 향후 Auth.js 연동용 시크릿 (현재 DB 회원 세션에서는 사용하지 않음)
# 생성: npx auth secret
AUTH_SECRET=""
# 프로덕션 회원 API의 허용 Origin. 반드시 실제 HTTPS 주소와 정확히 일치
AUTH_URL="http://localhost:3000"

# ── 토스페이먼츠 ────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# 통합 관리자: 실제 비밀번호/키는 커밋하지 않습니다.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# 최소 32바이트 무작위 값
ADMIN_SESSION_SECRET=""
# 프로덕션에서 필수: 실제 HTTPS 관리자 Origin
ADMIN_ORIGIN=""
