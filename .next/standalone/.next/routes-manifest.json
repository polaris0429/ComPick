      "namedRegex": "^/admin/orders(?:/)?$"
    },
    {
      "page": "/admin/products",
      "regex": "^/admin/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/products(?:/)?$"
    },
    {
      "page": "/admin-login",
      "regex": "^/admin\\-login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-login(?:/)?$"
    },
    {
      "page": "/api/admin/management",
      "regex": "^/api/admin/management(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/management(?:/)?$"
    },
    {
      "page": "/api/admin/prebuilts",
      "regex": "^/api/admin/prebuilts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/prebuilts(?:/)?$"
    },
    {
      "page": "/api/admin/products",
      "regex": "^/api/admin/products(?:/)?$",
