      "regex": "^/api/admin\\-session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin\\-session(?:/)?$"
    },
    {
      "page": "/cart",
      "regex": "^/cart(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cart(?:/)?$"
    },
    {
      "page": "/checkout",
      "regex": "^/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
